[Unit]
Description=UniFi Adaptive Fan Controller
After=basic.target
Documentation=https://github.com/diminDDL/unifi-fan-control

[Service]
Type=simple
User=root
WorkingDirectory=/data/fan-control
ExecStart=/data/fan-control/fan-control.sh
Restart=always
RestartSec=5
# 24h window for log rate limiting
LogRateLimitIntervalSec=1d
# Allow up to 2k logs/day from this service
LogRateLimitBurst=2000

[Install]
WantedBy=multi-user.target
